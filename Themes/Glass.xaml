<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OracleHost glass theme: dark surfaces, orange brand, soft cards -->

    <SolidColorBrush x:Key="WindowBg" Color="#0B0E13"/>
    <SolidColorBrush x:Key="CardBg" Color="#171D26"/>
    <SolidColorBrush x:Key="ConsoleBg" Color="#080D13"/>
    <SolidColorBrush x:Key="ChipBg" Color="#1E2530"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF681E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9DA8BA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#737F91"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#27D76C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB52D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EE4343"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#5A41F4"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#1787F7"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#16C96B"/>
    <SolidColorBrush x:Key="RedBrush" Color="#E5484D"/>

    <LinearGradientBrush x:Key="VioletGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5A41F4" Offset="0"/>
        <GradientStop Color="#4930E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1787F7" Offset="0"/>
        <GradientStop Color="#0871E7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16C96B" Offset="0"/>
        <GradientStop Color="#099A50" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F04444" Offset="0"/>
        <GradientStop Color="#C82929" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Primary gradient action buttons -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="#44FFFFFF" BorderThickness="1" Padding="14,12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Muted glass utility buttons -->
    <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <SolidColorBrush x:Key="UtilityBg" Color="#1B222D"/>

</ResourceDictionary>
