<Window x:Class="OracleHost.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OracleHost — Settings"
        Width="620" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="⚙ Settings" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Instance settings. Compartment, subnet, and region come from your AccountInfo bundle."
                       FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="1,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Instance Shape" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="ComboShape" Height="38" FontSize="14">
                <ComboBoxItem x:Name="ItemMicro" Content="VM.Standard.E2.1.Micro  (x86, fixed 1/8 OCPU / 1 GB, up to 2 instances)"/>
                <ComboBoxItem x:Name="ItemA1" Content="VM.Standard.A1.Flex  (ARM, Always Free: up to 2 OCPU / 12 GB total)"/>
            </ComboBox>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OCPUs (sent for A1.Flex)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ComboOcpus" Height="38" FontSize="14" SelectedIndex="1">
                        <ComboBoxItem Content="1 OCPU"/>
                        <ComboBoxItem Content="2 OCPUs"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Memory GB (sent for A1.Flex)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ComboMemory" Height="38" FontSize="14" SelectionChanged="ComboMemory_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Boot Volume GB (50–200)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SliderBoot" Width="330" Minimum="50" Maximum="200" TickFrequency="10"
                        IsSnapToTickEnabled="True" ValueChanged="SliderBoot_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBoot" Text="50 GB" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Display Name" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
            <TextBox x:Name="TxtDisplayName" Height="38" FontSize="14" Padding="8,0,0,0"
                     VerticalContentAlignment="Center"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Min Retry (seconds)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtMinRetry" Height="38" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Max Retry (seconds)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtMaxRetry" Height="38" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border CornerRadius="10" Background="#0A27D76C" BorderBrush="#3327D76C"
                    BorderThickness="1" Padding="14,10" Margin="0,18,0,0">
                <TextBlock x:Name="TxtSafety" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="#86EFAC"/>
            </Border>

            <TextBlock x:Name="TxtStatus" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="BtnSave" Style="{StaticResource ActionButton}"
                Background="{StaticResource GreenGrad}" Content="💾  Save Configuration"
                Height="48" FontSize="15" Margin="0,16,0,0" Click="BtnSave_Click"/>
    </Grid>
</Window>
