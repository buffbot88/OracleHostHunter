<Window x:Class="OracleHost.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OracleHost — Always Free Instance Hunter"
        Width="1240" Height="860" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32,22,32,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= Header ======= -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="13" Background="#26FF681E"
                        BorderBrush="#59FF7E2D" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Text="☁" FontSize="24" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OracleHost" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" LineHeight="28"/>
                    <TextBlock Text="Always Free hunter · 1 Check → 2 Try → 3 Hunt" FontSize="13"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="17" Background="#0AFFFFFF" BorderBrush="#59FF7E2D"
                        BorderThickness="1" Padding="14,8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtReady" Text="Ready to hunt" FontSize="13.5"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnTour" Style="{StaticResource GhostButton}"
                        Background="{StaticResource UtilityBg}" Content="?"
                        Width="40" Margin="0,0,10,0" Click="BtnTour_Click"
                        ToolTip="Replay the quick walkthrough."/>
                <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}"
                        Background="{StaticResource UtilityBg}" Content="⚙  Settings"
                        Padding="16,9" Click="BtnSettings_Click"
                        ToolTip="Change instance shape, sizing, and retry intervals."/>
            </StackPanel>
        </Grid>

        <!-- ======= Cards ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status card -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="22,20" ClipToBounds="True">
                <StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="●  IDLE" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="TxtStatusDescription" Text="Waiting to hunt for Always Free capacity..."
                               FontSize="13.5" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="2,4,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Background="#08FFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Attempts"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtAttempts" Text="0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="12" Background="#08FFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="No capacity"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtCapacityHits" Text="0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="12" Background="#08FFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Elapsed"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtElapsed" Text="00:00"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" CornerRadius="12" Background="#08FFFFFF"
                                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Retry in"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtNextRetry" Text="-"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="12"
                                Background="#08FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Availability domain"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtCurrentAd" Text="-"
                                           HorizontalAlignment="Right" FontSize="14"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Activity card -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="17" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Activity" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Live log" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" FontSize="13" Foreground="{StaticResource TextMuted}"
                               Margin="0,6,0,10" TextWrapping="Wrap"
                               Text="Leave the hunt running — it retries until Oracle has room, then sounds an alarm."/>
                    <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource ConsoleBg}"
                            BorderBrush="#1AFFFFFF" BorderThickness="1" ClipToBounds="True">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="13"
                                 Padding="12,10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 CaretBrush="Transparent"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======= Progress ======= -->
        <ProgressBar Grid.Row="2" x:Name="Progress" Margin="0,14,0,0" Visibility="Collapsed"/>

        <!-- ======= Success banner ======= -->
        <Border Grid.Row="3" x:Name="PanelSuccess" CornerRadius="14" Background="#14291D"
                BorderBrush="#3327D76C" BorderThickness="1" Padding="14,12" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="✓" FontSize="20" Foreground="#4ADE80"
                           VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold"/>
                <TextBlock x:Name="TxtSuccess" Grid.Column="1" Foreground="#86EFAC" FontSize="13.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="BtnCopySsh" Style="{StaticResource UtilityButton}"
                        Background="#16C96B" Content="Copy SSH" FontSize="13"
                        Padding="14,8" Margin="0,0,8,0" Click="BtnCopySsh_Click"/>
                <Button Grid.Column="3" x:Name="BtnCopyIp" Style="{StaticResource UtilityButton}"
                        Background="{StaticResource UtilityBg}" Content="Copy IP" FontSize="13"
                        Padding="14,8" Click="BtnCopyIp_Click"/>
            </Grid>
        </Border>

        <!-- ======= Primary actions: 3 steps ======= -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnPreflight" Style="{StaticResource ActionButton}"
                    Background="{StaticResource VioletGrad}" Click="BtnPreflight_Click"
                    ToolTip="Validates credentials, detects Always Free limits, and checks existing instances.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource NumberBadge}" Margin="0,0,12,0">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Check setup" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Validate in seconds" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="BtnOnce" Style="{StaticResource ActionButton}"
                    Background="{StaticResource BlueGrad}" Click="BtnOnce_Click"
                    ToolTip="Makes a single launch attempt, then stops.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource NumberBadge}" Margin="0,0,12,0">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Try once" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Single attempt" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" x:Name="BtnStart" Style="{StaticResource ActionButton}"
                    Background="{StaticResource GreenGrad}" Click="BtnStart_Click"
                    ToolTip="Retries automatically until capacity frees up. While hunting, this becomes Stop.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource NumberBadge}" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtStartIcon" Text="▶" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="TxtStartLabel" Text="Start hunting" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStartSub" Text="Retries until it succeeds" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======= Environment chips ======= -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                <TextBlock x:Name="TxtEnvCompartment" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
            </Border>
            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                <TextBlock x:Name="TxtEnvSsh" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
            </Border>
            <Border Style="{StaticResource Chip}">
                <TextBlock x:Name="TxtEnvRetry" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
            </Border>
        </StackPanel>

        <!-- ======= Utility row ======= -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnOpenLogs" Style="{StaticResource UtilityButton}"
                    Background="{StaticResource UtilityBg}" Click="BtnOpenLogs_Click"
                    ToolTip="Opens the folder containing the full diagnostic log file.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Diagnostic log" FontSize="13.5"/>
                        <TextBlock Text="Open the log file" FontSize="11.5" Opacity="0.65" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="BtnCopyLog" Style="{StaticResource UtilityButton}"
                    Background="{StaticResource UtilityBg}" Click="BtnCopyLog_Click"
                    ToolTip="Copies the activity log to the clipboard for sharing.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Copy activity" FontSize="13.5"/>
                        <TextBlock Text="Share what happened" FontSize="11.5" Opacity="0.65" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======= First-run walkthrough overlay ======= -->
        <Grid x:Name="TourOverlay" Grid.Row="0" Grid.RowSpan="7" Visibility="Collapsed"
              Background="Transparent">
            <!-- Dimmed scrim with a rounded hole cut over the target (geometry set in code) -->
            <Path x:Name="TourDim" Fill="#D90C1016" IsHitTestVisible="False"/>
            <!-- Glowing ring drawn around the target button -->
            <Border x:Name="TourRing" HorizontalAlignment="Left" VerticalAlignment="Top"
                    CornerRadius="16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#FF681E" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                </Border.Effect>
            </Border>
            <!-- Explanation card, positioned next to the target -->
            <Border x:Name="TourCard" Style="{StaticResource GlassCard}" Width="480"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28">
                <StackPanel>
                    <TextBlock x:Name="TxtTourCount" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="TxtTourTitle" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtTourBody" FontSize="14.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0" LineHeight="22"/>
                    <Grid Margin="0,26,0,0">
                        <Button x:Name="BtnTourSkip" HorizontalAlignment="Left" Style="{StaticResource GhostButton}"
                                Background="{StaticResource UtilityBg}" Content="Skip tour" Width="120"
                                Click="BtnTourSkip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnTourBack" Style="{StaticResource GhostButton}"
                                    Background="{StaticResource UtilityBg}" Content="Back" Width="110"
                                    Margin="0,0,10,0" Click="BtnTourBack_Click"/>
                            <Button x:Name="BtnTourNext" Style="{StaticResource ActionButton}"
                                    Background="{StaticResource BlueGrad}" Content="Next" Width="130"
                                    Click="BtnTourNext_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
