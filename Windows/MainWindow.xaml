<Window x:Class="OracleHost.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OracleHost — Always Free Instance Hunter"
        Width="1480" Height="940" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="36,24,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="*"/>     <!-- cards -->
            <RowDefinition Height="Auto"/>  <!-- progress -->
            <RowDefinition Height="Auto"/>  <!-- success -->
            <RowDefinition Height="Auto"/>  <!-- actions -->
            <RowDefinition Height="Auto"/>  <!-- env strip -->
            <RowDefinition Height="Auto"/>  <!-- utility -->
        </Grid.RowDefinitions>

        <!-- ======= Header ======= -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="☁" FontSize="40" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="OracleHost" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Border Width="1" Height="34" Background="#40FFFFFF" Margin="18,0"/>
                <TextBlock Text="Always Free Instance Hunter" FontSize="17"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="19" Background="#0AFFFFFF" BorderBrush="#59FF7E2D"
                    BorderThickness="1" Padding="18,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TxtReady" Text="Ready to hunt" FontSize="14"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======= Cards ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>

            <!-- Status card -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF681E" Offset="0"/>
                                <GradientStop Color="#00FF681E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" Margin="22,20,22,18">
                        <TextBlock x:Name="TxtStatus" Text="●  IDLE" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="TxtStatusDescription" Text="Waiting to hunt for Always Free capacity..."
                                   FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="2,4,0,16"/>
                        <Border CornerRadius="11" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                BorderThickness="1" Padding="14,0" Margin="0,0,0,8" Height="48">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Attempts:"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtAttempts" Text="0" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="11" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                BorderThickness="1" Padding="14,0" Margin="0,0,0,8" Height="48">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Capacity hits:"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtCapacityHits" Text="0" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="11" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                BorderThickness="1" Padding="14,0" Margin="0,0,0,8" Height="48">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Current AD:"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtCurrentAd" Text="-" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="11" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                BorderThickness="1" Padding="14,0" Margin="0,0,0,8" Height="48">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Elapsed:"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtElapsed" Text="00:00" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="11" Background="#08FFFFFF" BorderBrush="#14FFFFFF"
                                BorderThickness="1" Padding="14,0" Height="48">
                            <Grid>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Next retry:"/>
                                <TextBlock Style="{StaticResource StatValue}" x:Name="TxtNextRetry" Text="-" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activity card -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="18" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="ACTIVITY" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Live log" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource ConsoleBg}"
                            BorderBrush="#1AFFFFFF" BorderThickness="1" ClipToBounds="True">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="13.5"
                                 Padding="12,10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 CaretBrush="Transparent"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======= Progress ======= -->
        <ProgressBar Grid.Row="2" x:Name="Progress" Height="6" Margin="0,14,0,0" Visibility="Collapsed"
                     Foreground="{StaticResource AccentBrush}" Background="#202123"/>

        <!-- ======= Success banner ======= -->
        <Border Grid.Row="3" x:Name="PanelSuccess" CornerRadius="12" Background="#16301F"
                BorderBrush="#3327D76C" BorderThickness="1" Padding="14,10" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSuccess" Grid.Column="0" Foreground="#86EFAC" FontSize="13.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnCopySsh" Style="{StaticResource UtilityButton}"
                        Background="#16C96B" Content="📋 Copy SSH" Margin="0,0,8,0" Click="BtnCopySsh_Click"/>
                <Button Grid.Column="2" x:Name="BtnCopyIp" Style="{StaticResource UtilityButton}"
                        Background="{StaticResource UtilityBg}" Content="📋 Copy IP" Click="BtnCopyIp_Click"/>
            </Grid>
        </Border>

        <!-- ======= Primary actions ======= -->
        <Grid Grid.Row="4" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnPreflight" Style="{StaticResource ActionButton}"
                    Background="{StaticResource VioletGrad}" Click="BtnPreflight_Click"
                    ToolTip="Validates credentials, detects Always Free limits, and checks existing instances.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Preflight Check" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Validate configuration" FontSize="12.5" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="BtnOnce" Style="{StaticResource ActionButton}"
                    Background="{StaticResource BlueGrad}" Click="BtnOnce_Click"
                    ToolTip="Makes a single launch attempt, then stops.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Try Once" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Run a single check" FontSize="12.5" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" x:Name="BtnStart" Style="{StaticResource ActionButton}"
                    Background="{StaticResource GreenGrad}" Click="BtnStart_Click"
                    ToolTip="Retries automatically until capacity frees up. While hunting, this becomes Stop.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStartIcon" Text="▶" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtStartLabel" Text="Start Hunting" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStartSub" Text="Keep trying automatically" FontSize="12.5" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======= Environment strip ======= -->
        <Border Grid.Row="5" Margin="0,18,0,0" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtEnvCompartment" Foreground="{StaticResource TextSecondary}" FontSize="13.5"/>
                <Border Width="1" Height="16" Background="#30FFFFFF" Margin="16,0"/>
                <TextBlock x:Name="TxtEnvSsh" Foreground="{StaticResource TextSecondary}" FontSize="13.5"/>
                <Border Width="1" Height="16" Background="#30FFFFFF" Margin="16,0"/>
                <TextBlock x:Name="TxtEnvRetry" Foreground="{StaticResource TextSecondary}" FontSize="13.5"/>
            </StackPanel>
        </Border>

        <!-- ======= Utility row ======= -->
        <Grid Grid.Row="6" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnOpenLogs" Style="{StaticResource UtilityButton}"
                    Background="{StaticResource UtilityBg}" Click="BtnOpenLogs_Click" Height="64"
                    ToolTip="Opens the folder containing the full diagnostic log file.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="20" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Open Diagnostic Log"/>
                        <TextBlock Text="View detailed logs" FontSize="11.5" Opacity="0.65" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="BtnCopyLog" Style="{StaticResource UtilityButton}"
                    Background="{StaticResource UtilityBg}" Click="BtnCopyLog_Click" Height="64"
                    ToolTip="Copies the activity log to the clipboard for sharing.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="20" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Copy Activity Log"/>
                        <TextBlock Text="Copy to clipboard" FontSize="11.5" Opacity="0.65" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" x:Name="BtnSettings" Style="{StaticResource UtilityButton}"
                    Background="{StaticResource UtilityBg}" Click="BtnSettings_Click" Height="64"
                    ToolTip="Change instance shape, sizing, and retry intervals.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="20" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Settings"/>
                        <TextBlock Text="Configure options" FontSize="11.5" Opacity="0.65" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
