<Window x:Class="OracleHost.Windows.AccountInfoReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OracleHost — AccountInfo Report"
        Width="680" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AccountInfo Report" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Fields found in your AccountInfo bundle. Fix the missing ones and restart."
                       FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="1,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelFields"/>
        </ScrollViewer>

        <Button Grid.Row="2" Style="{StaticResource ActionButton}"
                Background="{StaticResource UtilityBg}" Content="Close"
                Height="42" Margin="0,16,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
