<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OracleHost</AssemblyName>
    <RootNamespace>OracleHost</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>OracleHost</Authors>
    <Description>Always Free ARM Instance Hunter - C# WinForms Client</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OCI.DotNetSDK.Common" Version="69.*" />
    <PackageReference Include="OCI.DotNetSDK.Core" Version="69.*" />
    <PackageReference Include="OCI.DotNetSDK.Identity" Version="69.*" />
    <PackageReference Include="OCI.DotNetSDK.Limits" Version="69.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
  </ItemGroup>

</Project>
